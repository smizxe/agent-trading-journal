{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smizxe/agent-trading-journal",
  "description": "AI trading journal: your agent logs trades from chart screenshots and checks your own rules.",
  "repository": {
    "url": "https://github.com/smizxe/agent-trading-journal",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agent-trading-journal",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JOURNAL_DATA_DIR",
          "description": "Folder for journal.db and screenshots (default ~/.agent-trading-journal)",
          "isRequired": false
        }
      ]
    }
  ]
}
